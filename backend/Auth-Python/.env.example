# ── Aplicación ──────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ── PostgreSQL ─────────────────────────────────────────
# Driver async: postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/TransmetroAuthDb

# Variables individuales (fallback si no hay DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=TransmetroAuthDb
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── JWT ────────────────────────────────────────────────
# IMPORTANTE: Estos valores DEBEN ser idénticos en todos los microservicios
JWT_SECRET=A_SUPER_SECRET_KEY_FOR_TRANSMETRO_CONECTA_12345
JWT_ISSUER=TransmetroAuthServer
JWT_AUDIENCE=TransmetroUsers
JWT_EXPIRES_IN=120
JWT_RESET_EXPIRES_IN=15

# ── MongoDB (Wallets — TransmetroUserDb) ──────────────
MONGODB_URI=mongodb://localhost:27017/TransmetroUserDb

# ── CORS ───────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Rate Limiting ──────────────────────────────────────
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
